{
  "name": "bj-safety-bid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "北京市应急管理局安全生产监管综合信息平台（二期）—安全生产检查和隐患治理信息子系统原型",
  "scripts": {
    "dev": "vite",
    "build": "npm run db:init && vue-tsc --noEmit && vite build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit",
    "postinstall": "node -e \"import('node:fs').then(fs=>fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/sql-wasm.wasm'))\"",
    "db:init": "node scripts/init-db.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "upload:r2": "node scripts/deploy-allworld.mjs bj-safety-bid",
    "deploy": "npm run build && node scripts/deploy-allworld.mjs bj-safety-bid"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "leaflet": "^1.9.4",
    "md5": "^2.3.0",
    "pinia": "^2.2.6",
    "sql.js": "^1.12.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/leaflet": "^1.9.15",
    "@types/md5": "^2.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^11.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10",
    "wrangler": "^3.91.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
